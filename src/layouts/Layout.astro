---
import NavBar from "../components/NavBar.astro";
import ChatBubble from "../components/ChatBubble.tsx";
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Analytics from "@vercel/analytics/astro";
import { fetchSanityData } from "../lib/sanity";
const profileImage = "https://ccharris.vercel.app/banner.jpg";
const contactsQuery = `*[_type == "contact"]{ url }`;
const contactsRawData = await fetchSanityData(contactsQuery);
const sameAs = (contactsRawData.result as { url: string }[])
    .map((contact) => contact.url)
    .filter((url) => url?.startsWith("http"));

const localBusinessJsonLd = {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: "Carlos César Harris Castillo — Desarrollo de Software",
    image: profileImage,
    url: "https://ccharris.vercel.app",
    description:
        "Desarrollador de software full stack en Mérida, especializado en aplicaciones web, móviles y sistemas de IA con LangChain y LangGraph.",
    address: {
        "@type": "PostalAddress",
        addressLocality: "Mérida",
        addressRegion: "Yucatán",
        addressCountry: "MX",
    },
    areaServed: {
        "@type": "City",
        name: "Mérida",
    },
    priceRange: "$$",
    sameAs,
};
---

<html lang="es">
    <head>
        <SEO
            title="Carlos César Harris Castillo — Full Stack Developer"
            description="Desarrollador Full Stack en Mérida, México. Especializado en Odoo, React Native y Docker. Experiencia en desarrollo web, mobile y ERP."
            author="Carlos César Harris Castillo"
            image={profileImage}
            url="https://ccharris.vercel.app"
            jsonLd={{
                "@context": "https://schema.org",
                "@type": "Person",
                name: "Carlos César Harris Castillo",
                jobTitle: "Full Stack Developer",
                description:
                    "Desarrollador Full Stack en Mérida, México. Especializado en Odoo, React Native y Docker",
                url: "https://ccharris.vercel.app",
                image: profileImage,
                sameAs,
                address: {
                    "@type": "PostalAddress",
                    addressLocality: "Mérida",
                    addressRegion: "Yucatán",
                    addressCountry: "MX",
                },
            }}
        />
        <script
            type="application/ld+json"
            set:html={JSON.stringify(localBusinessJsonLd)}
        />
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" href="/favicon.png" type="image/png" />
        <meta name="generator" content={Astro.generator} />
    </head>
    <body>
        <header>
            <NavBar />
        </header>
        <slot />
        <ChatBubble client:idle />
        <Analytics />
    </body>
</html>
<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
